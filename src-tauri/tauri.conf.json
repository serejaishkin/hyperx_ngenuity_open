{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "HyperHeadsetv2",
  "version": "0.2.45",
  "identifier": "com.hyperheadsetv2",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HyperX NGENUITY Open",
        "width": 980,
        "height": 600,
        "minWidth": 400,
        "minHeight": 300,
        "center": true
      },
      {
        "label": "compact",
        "url": "compact.html",
        "title": "HyperX NGENUITY Open",
        "width": 300,
        "height": 275,
        "minWidth": 240,
        "minHeight": 260,
        "maxWidth": 460,
        "maxHeight": 340,
        "center": true,
        "visible": false,
        "resizable": true
      },
      {
        "label": "dock",
        "url": "dock.html",
        "title": "HyperX NGENUITY Open",
        "width": 84,
        "height": 28,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4QzY0RUE3MzZDRjFFNTUKUldSVkhzODJwMDdHNkJCbW10cTJlMWFySHJvM3JTREQwZy9Wb0s5Y0VmdWtPNmd1UVRaMGc4N0IK",
      "endpoints": [
        "https://github.com/serejaishkin/hyperx_ngenuity_open/releases/latest/download/latest.json"
      ]
    }
  }
}
